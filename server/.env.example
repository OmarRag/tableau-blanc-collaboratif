# Copier ce fichier en « .env » et adapter les valeurs.
# Le sujet impose une configuration par variables d'environnement :
# aucun secret ne doit être écrit en dur dans le code.

# Port d'écoute du serveur
PORT=3000

# Clé secrète servant à signer les cookies de session.
# En production, mettre une longue chaîne aléatoire (ex: openssl rand -hex 32).
SESSION_SECRET=dev-secret-a-changer-en-production

# Chemin du fichier de base de données SQLite
DB_FILE=./data/whiteboard.db

# Origine autorisée pour le navigateur en développement (serveur Vite).
# En production, laisser vide : le serveur sert lui-même les fichiers du client.
CLIENT_ORIGIN=http://localhost:5173

# Mettre à "production" une fois déployé (active les cookies sécurisés HTTPS)
NODE_ENV=development
