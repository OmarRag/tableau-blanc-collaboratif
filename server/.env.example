# Copier ce fichier en « .env » et adapter les valeurs.
#   copy server\.env.example server\.env
#
# Le sujet impose une configuration par variables d'environnement : aucun
# secret n'est écrit dans le code. En local, ces valeurs viennent de ce
# fichier ; une fois en ligne, elles viennent du tableau de bord de
# l'hébergeur (Render → onglet « Environment »).
#
# ATTENTION : « .env » ne doit JAMAIS être envoyé sur GitHub. Il est déjà
# listé dans .gitignore. Seul « .env.example » est versionné.

# ---------------------------------------------------------------------------
# Port d'écoute.
# En local : 3000. Sur Render : ne rien mettre, l'hébergeur impose sa valeur.
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# Clé secrète qui signe les cookies de connexion et sale les mots de passe.
# En production, le serveur REFUSE de démarrer si cette valeur est laissée
# telle quelle. Générer une vraie valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=dev-secret-a-changer-en-production

# ---------------------------------------------------------------------------
# Base de données.
#
#   • Variable ABSENTE  → SQLite, dans le fichier indiqué par DB_FILE.
#                         C'est le mode local : rien à installer.
#   • Variable PRÉSENTE → PostgreSQL, à l'adresse indiquée.
#                         C'est le mode en ligne.
#
# Pourquoi ce changement pour la mise en ligne : Render efface le disque du
# service à chaque redéploiement. Un fichier SQLite y serait perdu à chaque
# mise à jour du code. PostgreSQL est hébergé séparément (Supabase ou Neon,
# offre gratuite), donc les comptes et les dessins survivent.
#
# La valeur à coller ressemble à ceci (fournie par Supabase ou Neon) :
#   postgresql://utilisateur:motdepasse@hote.exemple.com:5432/postgres
# ---------------------------------------------------------------------------
# DATABASE_URL=

# Chemin du fichier SQLite, utilisé uniquement quand DATABASE_URL est absente.
DB_FILE=./data/whiteboard.db

# ---------------------------------------------------------------------------
# Origine autorisée pour le navigateur en développement (serveur Vite).
# En production, tout part du même domaine : cette valeur est ignorée.
# ---------------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Limitation de débit (« rate limiting »), exigée par le sujet.
#
# Principe du seau à jetons : chaque adresse IP dispose de N jetons, une
# requête consomme un jeton, et le seau se remplit à la vitesse indiquée.
# Seau vide → le serveur répond 429 (« trop de requêtes »).
#
# Les valeurs par défaut (dans le code) sont celles de la PRODUCTION :
#   API   : 120 jetons, +2 par seconde
#   Auth  :  10 jetons, +0,1 par seconde (soit 1 essai toutes les 10 s)
#
# En local, les tests automatiques créent beaucoup de comptes d'affilée depuis
# la même adresse IP et se bloqueraient eux-mêmes. On assouplit donc le
# réglage des connexions ici — et SEULEMENT ici, jamais en production.
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_REFILL=2

# ---------------------------------------------------------------------------
# Mode d'exécution.
# « production » active les cookies sécurisés (transmis en HTTPS uniquement)
# et exige un vrai SESSION_SECRET. Render pose cette variable tout seul.
# ---------------------------------------------------------------------------
NODE_ENV=development
